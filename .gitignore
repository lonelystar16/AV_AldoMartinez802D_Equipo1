# Entorno y secretos
.env
*.env.local

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.coverage

# Node
node_modules/
dist/
build/

# Modelos y datos pesados
*.pt
*.onnx
datasets/
*.mp4

# Caché de Ultralytics: se regenera en cada validación y no debe versionarse
*.cache
# Excepción: el modelo final se versiona en Fase 2/Evidencias Proyecto/models/ (pesa menos de 100 MB)
!Fase 2/Evidencias Proyecto/models/*.pt
!Fase 2/Evidencias Proyecto/models/*.onnx

# Dataset y corridas de entrenamiento de YOLO: se descargan o se regeneran.
# Se conserva solo train-9 (métricas y gráficos de la corrida del modelo
# entregado); sus pesos quedan fuera por la regla *.pt.
Fase 2/Evidencias Proyecto/Yolo/dataset/images/
Fase 2/Evidencias Proyecto/Yolo/dataset/labels/
Fase 2/Evidencias Proyecto/Yolo/runs/detect/*
!Fase 2/Evidencias Proyecto/Yolo/runs/detect/train-9/

# Salidas de ejecución local: evidencia, incidentes y cola del agente Edge
Fase 2/Evidencias Proyecto/incidents/
Fase 2/Evidencias Proyecto/db/incidents.json
Fase 2/Evidencias Proyecto/db/cola_incidentes.jsonl
*.tmp

# Cascadas Haar que descargan los scripts de prueba
haarcascade_*.xml

# Sistema / editores
.DS_Store
Thumbs.db
~$*
.vscode/
.idea/

# Archivos temporales de trabajo del agente
.ai/
agents.md
AGENTS.md

# Salidas locales de pruebas y del receptor simulado
/Fase 2/Evidencias Proyecto/tests/logs/
/Fase 2/Evidencias Proyecto/src/firmware/receptor-sim/alerts.jsonl
/graphify-out/
