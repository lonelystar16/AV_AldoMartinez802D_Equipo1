# Entorno y secretos
.env
*.env.local

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.coverage

# Node
node_modules/
dist/
build/

# Modelos y datos pesados
*.pt
*.onnx
datasets/
*.mp4

# Caché de Ultralytics: se regenera en cada validación y no debe versionarse
*.cache
# Excepción: el modelo final se versiona en Fase 2/Evidencias Proyecto/models/ (pesa menos de 100 MB)
!Fase 2/Evidencias Proyecto/models/*.pt
!Fase 2/Evidencias Proyecto/models/*.onnx

# Dataset y corridas de entrenamiento de YOLO: se descargan o se regeneran.
# Se conserva solo train-9 (métricas y gráficos de la corrida del modelo
# entregado); sus pesos quedan fuera por la regla *.pt.
#
# OJO: en .gitignore la barra invertida es carácter de escape, no separador.
# Estas rutas deben llevar "/" para que la regla aplique.
Fase 2/Evidencias Proyecto/Yolo/dataset/train/
Fase 2/Evidencias Proyecto/Yolo/dataset/valid/
Fase 2/Evidencias Proyecto/Yolo/dataset/test/
Fase 2/Evidencias Proyecto/Yolo/runs/detect/*
!Fase 2/Evidencias Proyecto/Yolo/runs/detect/train-9/

# Ultralytics crea las carpetas de validacion en el directorio de trabajo
# desde el que se lanza. Si se evalua desde la raiz, aparece aqui.
runs/

# Salidas de ejecución local: evidencia, incidentes y cola del agente Edge
Fase 2/Evidencias Proyecto/incidents/
Fase 2/Evidencias Proyecto/db/incidents.json
Fase 2/Evidencias Proyecto/db/cola_incidentes.jsonl
*.tmp

# Cache de etiquetas que genera Ultralytics al escanear el dataset
*.cache

# Cascadas Haar que descargan los scripts de prueba
haarcascade_*.xml

# Sistema / editores
.DS_Store
Thumbs.db
~$*
.vscode/
.idea/

# Archivos temporales de trabajo del agente
.ai/
# OJO: en Windows git compara los nombres sin distinguir mayusculas
# (core.ignorecase=true), asi que una regla 'agents.md' tambien capturaba
# 'AGENTS.md'. La barra inicial la ancla a la raiz, y se excluye el archivo
# del proyecto.
agents.md
!/.opencode/AGENTS.md
