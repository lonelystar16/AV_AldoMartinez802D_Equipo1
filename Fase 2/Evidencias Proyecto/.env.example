# Copiar a .env y completar. Nunca subir .env al repositorio.
# Lo leen tanto `docker compose` como la API fuera de Docker.
# Almacenamiento de incidentes: json (desarrollo) o postgres
CASCOVISION_STORAGE=json
POSTGRES_DB=cascovision
POSTGRES_USER=cascovision
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
JWT_SECRET=cambiar_esto
EDGE_API_TOKEN=cambiar_esto
BALIZA_TOKEN=cambiar_esto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Docker (compose.yaml) ---
# Con Docker, compose fija CASCOVISION_STORAGE=postgres y POSTGRES_HOST=db.
# Fuente de video del agente Edge. Vacio = la de docker/edge/config.json (camara
# simulada con --profile dev). En la faena: rtsp://usuario:clave@IP:554/stream1
CAMARA_FUENTE=
# 1 = carga catalogos e incidentes de demostracion al crear la base (camara-01,
# zona-norte, baliza-01). Poner 0 en produccion.
CASCOVISION_SEED=1
# Puerto de la API en 127.0.0.1 del equipo.
API_PUERTO=8000
